FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_2 }    INPUT  FEATURE_TYPE AttributeManager_BPart_OUTPUT    TEST { gml_id ATTRIBUTE_HAS_A_VALUE "" ENCODED } CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>gml_id<closeparen>,Tester_2)" BEGINS_WITH Part_ ENCODED } TEST { gml_parent_id ATTRIBUTE_HAS_A_VALUE "" ENCODED } CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>gml_parent_id<closeparen>,Tester_2)" BEGINS_WITH DESNALK ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>gml_id<closeparen>,Tester_2)" != "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>gml_parent_id<closeparen>,Tester_2)" ENCODED }    BOOLEAN_OPERATOR { AND }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_2_PASSED         }
